rule-name-prefix DQC

/** V31 Release **/


Assert US.0251.10964 satisfied

$rule_id = (rule-name().split('.'))[rule-name().split('.').length];

$IncorrectAxis = {@concept = UnrecordedUnconditionalPurchaseObligationBalanceSheetAmount}

 true                       

message
"
The filer has reported a member  that is used across different incompatible dimensions.  The incompatible dimensions this member is used on are duplicateMembers.  Members should be used on dimensions of the same type.  Please ensure that the class of the dimensions are the same if a member is used across different dimensions.

Rule Element Id:{$rule_id}
Rule version: {$ruleVersion}"

severity error  
effectiveDate $effective_dates[$rule_id]
